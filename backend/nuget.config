<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear: отсекаем источники из пользовательского конфига NuGet на этой машине
         (например, приватные реестры, недоступные без VPN/пароля и ломающие restore ошибкой
         NU1301 "Unable to load the service index"). Проект восстанавливается только отсюда. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
