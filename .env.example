# ============================================================
#  Шаблон файла .env — скопируй в .env и заполни своими значениями:
#      cp .env.example .env      (Linux/macOS/Git Bash)
#      copy .env.example .env    (Windows cmd)
#
#  .env в git не попадает (см. .gitignore) — реальные пароли
#  живут только на твоей машине.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=directory_service

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=postgres@postgres.ru
PGADMIN_DEFAULT_PASSWORD=postgres
